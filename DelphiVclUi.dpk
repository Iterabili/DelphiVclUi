package DelphiVclUi;

{$ALIGN 8}
{$ASSERTIONS ON}
{$BOOLEVAL OFF}
{$DEBUGINFO OFF}
{$EXTENDEDSYNTAX ON}
{$IMPORTEDDATA ON}
{$IOCHECKS ON}
{$LOCALSYMBOLS OFF}
{$LONGSTRINGS ON}
{$OPENSTRINGS ON}
{$OPTIMIZATION ON}
{$OVERFLOWCHECKS OFF}
{$RANGECHECKS OFF}
{$REFERENCEINFO OFF}
{$SAFEDIVIDE OFF}
{$STACKFRAMES OFF}
{$TYPEDADDRESS OFF}
{$VARSTRINGCHECKS ON}
{$WRITEABLECONST OFF}
{$MINENUMSIZE 1}
{$IMAGEBASE $400000}
{$DESCRIPTION 'Vcl Ui controls'}
{$LIBSUFFIX AUTO}
{$RUNONLY}
{$IMPLICITBUILD ON}

requires
  rtl,
  vcl,
  vclwinx,
  vclx;

contains
  uUiTheme in 'uUiTheme.pas',
  uUiPaint in 'uUiPaint.pas',
  uUiCard in 'uUiCard.pas',
  uUiPopup in 'uUiPopup.pas',
  uUiButton in 'uUiButton.pas',
  uUiCheck in 'uUiCheck.pas',
  uUiEdit in 'uUiEdit.pas',
  uUiTimeEdit in 'uUiTimeEdit.pas',
  uUiMemo in 'uUiMemo.pas',
  uUiSelect in 'uUiSelect.pas',
  uUiDatePicker in 'uUiDatePicker.pas',
  uUiColorPicker in 'uUiColorPicker.pas',
  uUiTable in 'uUiTable.pas',
  uUiSchedule in 'uUiSchedule.pas',
  uUiHint in 'uUiHint.pas',
  uUiTabs in 'uUiTabs.pas',
  uUiListBox in 'uUiListBox.pas',
  uUiMenuBar in 'uUiMenuBar.pas',
  uUiForm in 'uUiForm.pas';

end.
